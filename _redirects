# Alte englische URL → neue deutsche URL (301).
/dataintegrity        /datenschutz.html   301
/dataintegrity.html   /datenschutz.html   301

# Interne/Entwickler-Dateien: 404 statt Inhalt.
# Hinweis: greift nur für Pfade OHNE echtes File – Cloudflare Pages liefert
# vorhandene Dateien direkt aus. Wirklich verstecken = nicht deployen (siehe
# Notiz im Deployment-Doc / public-Ordner-Ansatz).
/docs/*      /404.html   404
/*.md        /404.html   404
